<?php

// Extra keyboard shortcuts, in addition to the built-in bindings.
//
// Each entry adds a key binding to a Roundcube command name. If a configured key is
// already a built-in shortcut, the configured command takes precedence for that key.
// Adding the command on a new key does not disable its built-in key; both remain active.
// Configured bindings are also listed in the shortcut help dialog.
//
// Use the Roundcube command names the plugin itself uses, e.g.:
//   delete, forward, reply-all, print, compose, list, nextpage, previouspage,
//   nextmessage, previousmessage, checkmail, plugin.archive, expand-all, collapse-all
//
// Three equivalent forms:
//
//   $config['keyboard_shortcuts_extras'] = array(
//       'x' => 'delete',                                  // mailbox view
//       'mailbox' => array('x' => 'delete'),              // explicit scope
//       's' => array('command' => 'delete', 'scope' => 'both'),
//   );
//
// 'scope' (or the top-level grouping) is one of 'mailbox', 'show', or 'both'.
// 'mailbox' is the message list; 'show' is an open message. Default scope is 'mailbox'.
//
// Example: add delete on 'x' and search on 's' (the built-in 'd' and '/' still work):
//
//   $config['keyboard_shortcuts_extras'] = array(
//       'mailbox' => array(
//           'x' => 'delete',
//           's' => array('command' => 'search', 'scope' => 'mailbox'),
//       ),
//   );

$config['keyboard_shortcuts_extras'] = array();
